# ==============================================================================
# GG AUTOMATION ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Publishable Key (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Secret Key (Server-side ONLY - NEVER prefix with NEXT_PUBLIC_)
# From Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage Bucket (Defaults to 'project-media' if not specified)
SUPABASE_STORAGE_BUCKET=project-media

# Admin CRM Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
